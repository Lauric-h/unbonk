<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Race\Entity\RunnerRace" table="runner_races">

        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>

        <field name="runnerId" type="string" length="36" column="runner_id"/>
        <field name="sourceRaceId" type="string" length="64" column="source_race_id"/>
        <field name="eventId" type="string" length="64" column="event_id"/>
        <field name="eventName" type="string" length="255" column="event_name"/>
        <field name="name" type="string" length="255"/>
        <field name="distance" type="integer" column="distance_in_meters"/>
        <field name="ascent" type="integer"/>
        <field name="descent" type="integer"/>
        <field name="startDateTime" type="datetime_immutable" column="start_date_time"/>
        <field name="location" type="string" length="255"/>

        <!--
            cascade persist uniquement : RunnerRace est le seul point d'entrée qui crée
            des Checkpoint/Segment (via import()). Pas de "remove" en cascade individuel,
            la suppression de la course entière suffit (cf. onDelete CASCADE en DB).
        -->
        <one-to-many field="checkpoints" target-entity="App\Domain\Race\Entity\Checkpoint" mapped-by="runnerRace">
            <cascade>
                <cascade-persist/>
            </cascade>
            <order-by>
                <order-by-field name="distanceFromStart" direction="ASC"/>
            </order-by>
        </one-to-many>

        <one-to-many field="segments" target-entity="App\Domain\Race\Entity\Segment" mapped-by="runnerRace">
            <cascade>
                <cascade-persist/>
            </cascade>
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>