<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\NutritionPlan\Entity\SegmentNutritionPlan" table="segment_nutrition_plans">

        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>

        <field name="segmentId" type="string" length="36" column="segment_id"/>
        <field name="position" type="integer"/>

        <embedded name="targetCarbs" class="App\Domain\NutritionPlan\Entity\Carbs" use-column-prefix="false"/>

        <many-to-one field="nutritionPlan" target-entity="App\Domain\NutritionPlan\Entity\NutritionPlan">
            <join-column name="nutrition_plan_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <!--
            addNutritionItem()/removeNutritionItem() sont de vraies opérations de mutation utilisées
            en usage courant (contrairement à Checkpoint/Segment côté Race) : cascade-persist
            pour créer les NutritionItem en même temps que le SegmentNutritionPlan à l'import,
            orphan-removal + cascade-remove pour que removeNutritionItem() génère un vrai DELETE.
        -->
        <one-to-many field="nutritionItems" target-entity="App\Domain\NutritionPlan\Entity\NutritionItem" mapped-by="segmentNutritionPlan" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <unique-constraints>
            <unique-constraint columns="nutrition_plan_id,segment_id" name="uniq_segment_nutrition_plan_plan_segment"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
