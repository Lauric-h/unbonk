{% extends 'base.html.twig' %}

{% block title %}Mes courses importées{% endblock %}

{% block body %}

    <ul>
        {% for race in races %}
            <li><a href="{{ url('app.runner_races.show', {id: race.id}) }}">{{ race.name }} - {{ race.distance / 1000}} km</a></li>
        {% endfor %}
    </ul>
{% endblock %}