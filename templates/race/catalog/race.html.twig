{% extends 'base.html.twig' %}

{% block title %}Race{% endblock %}

{% block body %}
    <div>
        <form action="{{ url('app.catalog.event.race.import', {eventId: race.eventId, raceId: race.id}) }}" method="post">
            <p>{{ race.name }}</p>
            <p>{{ race.distanceInMeters / 100 }}km</p>
            <p>{{ race.ascent }}m de dénivelé</p>
            <button>Importer</button>
        </form>
    </div>
{% endblock %}